+static const VkDeviceSize kStagingPoolMax = 96ull << 20;
+
+void
+release_staging_buffer(struct device *dev, std::unique_ptr<struct buffer> buf)
+{
+	if (!buf)
+		return;
+	if (!dev->stop_thread && buf->size <= kStagingPoolMax / 4) {
+		std::lock_guard<std::mutex> l(dev->stagingPoolLock);
+		if (dev->stagingPoolBytes + buf->size <= kStagingPoolMax) {
+			dev->stagingPoolBytes += buf->size;
+			VkDeviceSize size = buf->size;
+			dev->stagingPool.emplace(size, std::move(buf));
+			return;
+		}
+	}
+	dev->table.DestroyBuffer(dev->handle, buf->handle, buf->alloc);
+	dev->table.FreeMemory(dev->handle, buf->memory, buf->alloc);
+}
+
+void
+clear_staging_pool(struct device *dev)
+{
+	std::lock_guard<std::mutex> l(dev->stagingPoolLock);
+	for (auto &entry : dev->stagingPool) {
+		dev->table.DestroyBuffer(dev->handle, entry.second->handle, entry.second->alloc);
+		dev->table.FreeMemory(dev->handle, entry.second->memory, entry.second->alloc);
+	}
+	dev->stagingPool.clear();
+	dev->stagingPoolBytes = 0;
+}
+
