+#elif defined(__ANDROID__)
+/* Android has no gbm, and its drivers (Mali's among them) import dma-bufs but often cannot export
+ * them. The storage comes from an uncached dma-buf heap or from gralloc as a BLOB
+ * AHardwareBuffer (see vkr_android_heap_alloc), and is imported as a plain dma-buf.
+ */
+#include <android/hardware_buffer.h>
+#include <dlfcn.h>
+#include <fcntl.h>
+#include <linux/dma-heap.h>
+#include <sys/ioctl.h>
+
+struct vkr_android_bo {
+   AHardwareBuffer *ahb;
+   int fd;
+};
+
+typedef const struct {
+   int version;
+   int numFds;
+   int numInts;
+   int data[];
+} *vkr_native_handle;
+
+/* Mali imports a dma-buf without syncing the CPU cache around GPU work, and nothing here can call
+ * DMA_BUF_IOCTL_SYNC for the guest's writes through its mapping, so a cached buffer (the system
+ * heap) left stale lines on the GPU's side: garbled windows. Uncached heaps first, then gralloc
+ * (its BLOB buffers with CPU_*_RARELY usage are uncached on Mali), the cached heap last.
+ * VKR_DMA_HEAPS overrides the heap list, e.g. "system" to compare.
+ */
+static int
+vkr_android_heap_open(const char *name)
+{
+   char path[64];
+   snprintf(path, sizeof(path), "/dev/dma_heap/%s", name);
+   return open(path, O_RDONLY | O_CLOEXEC);
+}
+
+static int
+vkr_android_heap_alloc_from(int heap_fd, const char *name, size_t size)
+{
+   struct dma_heap_allocation_data data = {
+      .len = size,
+      .fd_flags = O_RDWR | O_CLOEXEC,
+   };
+   if (ioctl(heap_fd, DMA_HEAP_IOCTL_ALLOC, &data) < 0) {
+      vkr_log("dma_heap %s: alloc of %zu failed (%s)", name, size, strerror(errno));
+      return -1;
+   }
+   return (int)data.fd;
+}
+
+/* The first uncached heap that opens, or -1 (then gralloc). */
+static int
+vkr_android_heap_alloc(size_t size)
+{
+   static int heap_fd = -2;
+   static char heap_name[32];
+   if (heap_fd == -2) {
+      const char *list = getenv("VKR_DMA_HEAPS");
+      if (!list || !*list)
+         list = "system-uncached,mtk_mm-uncached";
+      char buf[128];
+      snprintf(buf, sizeof(buf), "%s", list);
+      for (char *save = NULL, *name = strtok_r(buf, ",", &save); name;
+           name = strtok_r(NULL, ",", &save)) {
+         heap_fd = vkr_android_heap_open(name);
+         if (heap_fd >= 0) {
+            snprintf(heap_name, sizeof(heap_name), "%s", name);
+            vkr_log("shared memory from dma_heap %s", name);
+            break;
+         }
+      }
+      if (heap_fd < 0) {
+         heap_fd = -1;
+         vkr_log("no uncached dma_heap among %s; shared memory from gralloc", list);
+      }
+   }
+   if (heap_fd < 0)
+      return -1;
+   return vkr_android_heap_alloc_from(heap_fd, heap_name, size);
+}
+
+/* Last resort: the cached system heap (fine where the GPU snoops the CPU's caches). */
+static int
+vkr_android_cached_heap_alloc(size_t size)
+{
+   static int heap_fd = -2;
+   if (heap_fd == -2) {
+      heap_fd = vkr_android_heap_open("system");
+      vkr_log(heap_fd >= 0 ? "falling back to the cached dma_heap system"
+                           : "no dma_heap system either");
+   }
+   if (heap_fd < 0)
+      return -1;
+   return vkr_android_heap_alloc_from(heap_fd, "system", size);
+}
+
+static int
+vkr_android_ahb_alloc(size_t size, AHardwareBuffer **out_ahb)
+{
+   static vkr_native_handle (*get_native_handle)(const AHardwareBuffer *);
+   if (!get_native_handle) {
+      void *lib = dlopen("libnativewindow.so", RTLD_NOW);
+      if (lib)
+         get_native_handle = (vkr_native_handle(*)(const AHardwareBuffer *))dlsym(
+            lib, "AHardwareBuffer_getNativeHandle");
+      if (!get_native_handle) {
+         lib = dlopen("libandroid.so", RTLD_NOW);
+         if (lib)
+            get_native_handle = (vkr_native_handle(*)(const AHardwareBuffer *))dlsym(
+               lib, "AHardwareBuffer_getNativeHandle");
+      }
+      if (!get_native_handle) {
+         vkr_log("AHardwareBuffer_getNativeHandle not found");
+         return -1;
+      }
+   }
+
+   const AHardwareBuffer_Desc desc = {
+      .width = size,
+      .height = 1,
+      .layers = 1,
+      .format = AHARDWAREBUFFER_FORMAT_BLOB,
+      .usage = AHARDWAREBUFFER_USAGE_GPU_DATA_BUFFER | AHARDWAREBUFFER_USAGE_CPU_READ_RARELY |
+               AHARDWAREBUFFER_USAGE_CPU_WRITE_RARELY,
+   };
+   AHardwareBuffer *ahb = NULL;
+   int ret = AHardwareBuffer_allocate(&desc, &ahb);
+   if (ret) {
+      vkr_log("AHardwareBuffer_allocate of %zu failed (%d)", size, ret);
+      return -1;
+   }
+
+   vkr_native_handle handle = get_native_handle(ahb);
+   for (int i = 0; handle && i < handle->numFds; i++) {
+      const off_t fd_size = lseek(handle->data[i], 0, SEEK_END);
+      if (fd_size >= 0 && (size_t)fd_size >= size) {
+         int fd = os_dupfd_cloexec(handle->data[i]);
+         if (fd >= 0) {
+            *out_ahb = ahb;
+            return fd;
+         }
+      }
+   }
+   vkr_log("AHardwareBuffer of %zu has no dma-buf of that size", size);
+   AHardwareBuffer_release(ahb);
+   return -1;
+}
+
+static int
+vkr_gbm_bo_get_fd(void *gbm_bo)
+{
+   struct vkr_android_bo *bo = gbm_bo;
+   return os_dupfd_cloexec(bo->fd);
+}
+
+static void
+vkr_gbm_bo_destroy(void *gbm_bo)
+{
+   struct vkr_android_bo *bo = gbm_bo;
+   close(bo->fd);
+   if (bo->ahb)
+      AHardwareBuffer_release(bo->ahb);
+   free(bo);
+}
+
+static VkResult
+vkr_gbm_get_fd_info_from_allocation_info(UNUSED struct vkr_physical_device *physical_dev,
+                                         const VkMemoryAllocateInfo *alloc_info,
+                                         void **out_gbm_bo,
+                                         VkImportMemoryFdInfoKHR *out_fd_info)
+{
+   if (alloc_info->allocationSize > UINT32_MAX)
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+
+   struct vkr_android_bo *bo = calloc(1, sizeof(*bo));
+   if (!bo)
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+
+   const size_t size = align(alloc_info->allocationSize, getpagesize());
+   bo->fd = vkr_android_heap_alloc(size);
+   if (bo->fd < 0)
+      bo->fd = vkr_android_ahb_alloc(size, &bo->ahb);
+   if (bo->fd < 0)
+      bo->fd = vkr_android_cached_heap_alloc(size);
+   if (bo->fd < 0) {
+      free(bo);
+      return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+   }
+
+   const int fd = os_dupfd_cloexec(bo->fd);
+   if (fd < 0) {
+      vkr_gbm_bo_destroy(bo);
+      return VK_ERROR_TOO_MANY_OBJECTS;
+   }
+
+   *out_gbm_bo = bo;
+   *out_fd_info = (VkImportMemoryFdInfoKHR){
+      .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_FD_INFO_KHR,
+      .pNext = alloc_info->pNext,
+      .fd = fd,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+   };
+   return VK_SUCCESS;
+}
