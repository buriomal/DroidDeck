+#if defined(__ANDROID__)
+/* The memory path allocates dma-bufs outside a driver that can only import them, so any memory
+ * the driver can import as a dma-buf can also be exported: say so, or gamescope finds no
+ * exportable modifier for its scanout images.
+ */
+static void
+vkr_android_fake_dma_buf_export(const struct vkr_physical_device *physical_dev,
+                                VkExternalMemoryHandleTypeFlagBits handle_type,
+                                VkExternalMemoryProperties *props)
+{
+   if (handle_type != VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT ||
+       physical_dev->is_dma_buf_fd_export_supported ||
+       !(props->externalMemoryFeatures & VK_EXTERNAL_MEMORY_FEATURE_IMPORTABLE_BIT))
+      return;
+
+   props->externalMemoryFeatures |= VK_EXTERNAL_MEMORY_FEATURE_EXPORTABLE_BIT;
+   props->exportFromImportedHandleTypes |= VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
+   props->compatibleHandleTypes |= VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
+}
+#endif
