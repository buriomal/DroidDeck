 #include "drm-uapi/panthor_drm.h"
 
 #include "kbase_kmod.h"
+
+/* Vendor kbase builds move uAPI structs around between releases without
+ * changing the ioctl numbers, and the kernel then rejects a request whose
+ * encoded size differs with ENOTTY (MediaTek's r54p1 on the Dimensity 9500
+ * does so for MEM_ALLOC_EX and MEM_IMPORT). On ENOTTY for a kbase ioctl,
+ * retry with the size grown (zero-padded) or shrunk in 8-byte steps, keep
+ * whichever the kernel accepts for that ioctl number, and say so once. */
+static int16_t kbase_ioctl_size_delta[256];
+static bool kbase_ioctl_size_known[256];
+
+static int
+kbase_xioctl(int fd, unsigned long req, void *arg)
+{
+   unsigned nr = _IOC_NR(req), size = _IOC_SIZE(req);
+
+   if (_IOC_TYPE(req) != 0x80 || !size || !arg)
+      return ioctl(fd, req, arg);
+
+   if (!kbase_ioctl_size_known[nr] || !kbase_ioctl_size_delta[nr]) {
+      int ret = ioctl(fd, req, arg);
+      if (ret == 0 || errno != ENOTTY || kbase_ioctl_size_known[nr])
+         return ret;
+   }
+
+   uint8_t buf[512];
+   int deltas[64], count = 0;
+   if (kbase_ioctl_size_known[nr]) {
+      deltas[count++] = kbase_ioctl_size_delta[nr];
+   } else {
+      for (int d = 8; d <= 160 && count < 64; d += 8) {
+         deltas[count++] = d;
+         if ((int)size - d >= 8)
+            deltas[count++] = -d;
+      }
+   }
+
+   for (int i = 0; i < count; i++) {
+      unsigned try_size = size + deltas[i];
+      if (try_size > sizeof(buf) || try_size > _IOC_SIZEMASK)
+         continue;
+      memset(buf, 0, sizeof(buf));
+      memcpy(buf, arg, MIN2(size, try_size));
+      unsigned long try_req = _IOC(_IOC_DIR(req), _IOC_TYPE(req), nr, try_size);
+      int ret = ioctl(fd, try_req, buf);
+      if (ret != 0 && errno == ENOTTY)
+         continue;
+      int saved = errno;
+      if (_IOC_DIR(req) & _IOC_READ)
+         memcpy(arg, buf, MIN2(size, try_size));
+      if (!kbase_ioctl_size_known[nr]) {
+         kbase_ioctl_size_known[nr] = true;
+         kbase_ioctl_size_delta[nr] = deltas[i];
+         mesa_logi("kbase: ioctl nr %u takes %u bytes here (built with %u)",
+                   nr, try_size, size);
+      }
+      errno = saved;
+      return ret;
+   }
+   kbase_ioctl_size_known[nr] = true;
+   kbase_ioctl_size_delta[nr] = 0;
+   mesa_loge("kbase: ioctl nr %u refused at every size near %u", nr, size);
+   errno = ENOTTY;
+   return -1;
+}
