       .lineWidthRange = {0.0, 7.9921875},
diff --git a/src/panfrost/vulkan/panvk_vX_shader.c b/src/panfrost/vulkan/panvk_vX_shader.c
index ec4df409ddb..712fe935560 100644
--- a/src/panfrost/vulkan/panvk_vX_shader.c
+++ b/src/panfrost/vulkan/panvk_vX_shader.c
@@ -19,6 +19,7 @@
 #include "panvk_physical_device.h"
 #include "panvk_sampler.h"
 #include "panvk_shader.h"
+#include "util/u_debug.h"
 
 #include "spirv/nir_spirv.h"
 #include "util/memstream.h"
@@ -626,6 +627,53 @@ panvk_get_spirv_options(UNUSED struct vk_physical_device *vk_pdev,
    };
 }
 
+/* Mali has no clip or cull distances. DXVK refuses a device without them
+ * (and D3D11 games then stop with "DX11 feature level 10.0 is required"),
+ * while games rarely write SV_ClipDistance/SV_CullDistance. The features
+ * are reported and the variables demoted to temporaries here, so a shader
+ * that writes them compiles and draws unclipped instead of failing. The
+ * viewport index goes the same way, as only viewport 0 is drawn.
+ * TODO: lower clip distances to a fragment-shader discard. */
+static bool
+panvk_drop_clip_cull_vars(nir_shader *nir)
+{
+   bool progress = false;
+
+   nir_foreach_variable_with_modes(var, nir,
+                                   nir_var_shader_in | nir_var_shader_out) {
+      if (nir->info.stage == MESA_SHADER_FRAGMENT &&
+          var->data.mode == nir_var_shader_out)
+         continue;
+      switch (var->data.location) {
+      case VARYING_SLOT_CLIP_DIST0:
+      case VARYING_SLOT_CLIP_DIST1:
+      case VARYING_SLOT_CULL_DIST0:
+      case VARYING_SLOT_CULL_DIST1:
+      case VARYING_SLOT_VIEWPORT:
+         var->data.mode = nir_var_shader_temp;
+         var->data.compact = false;
+         progress = true;
+         break;
+      default:
+         break;
+      }
+   }
+
+   if (progress) {
+      const uint64_t bits = VARYING_BIT_CLIP_DIST0 | VARYING_BIT_CLIP_DIST1 |
+                            VARYING_BIT_CULL_DIST0 | VARYING_BIT_CULL_DIST1 |
+                            VARYING_BIT_VIEWPORT;
+      nir_fixup_deref_modes(nir);
+      nir->info.clip_distance_array_size = 0;
+      nir->info.cull_distance_array_size = 0;
+      if (nir->info.stage != MESA_SHADER_FRAGMENT)
+         nir->info.outputs_written &= ~bits;
+      if (nir->info.stage != MESA_SHADER_VERTEX)
+         nir->info.inputs_read &= ~bits;
+   }
+   return progress;
+}
+
 static void
 panvk_preprocess_nir(struct vk_physical_device *vk_pdev,
                      nir_shader *nir,
@@ -633,6 +681,12 @@ panvk_preprocess_nir(struct vk_physical_device *vk_pdev,
 {
    struct panvk_physical_device *pdev = to_panvk_physical_device(vk_pdev);
 
+   /* Only where the features are reported (PANVK_DXVK_FEATURES, see
+    * panvk_vX_physical_device.c): elsewhere shaders compile as they always did. */
+   if (nir->info.stage != MESA_SHADER_COMPUTE &&
+       debug_get_bool_option("PANVK_DXVK_FEATURES", false))
+      NIR_PASS(_, nir, panvk_drop_clip_cull_vars);
+
    /* Ensure to regroup output variables at the same location */
    if (nir->info.stage == MESA_SHADER_FRAGMENT)
       NIR_PASS(_, nir, nir_opt_vectorize_io_vars, nir_var_shader_out);
