kbase: wait for semaphores on the GPU where possible

Waits on this device's own work become CQS waits in the ring even when
the submit also waits on something else (only that is waited on the
CPU), shared cells are merged, reached or signaled waits are dropped,
and a wait-only submit waiting on its own queue doesn't wait at all.

--- a/src/panfrost/vulkan/csf/panvk_vX_gpu_queue.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_gpu_queue.c
@@ -22,6 +22,7 @@
 
 #include "util/bitscan.h"
 #include "util/os_time.h"
+#include "util/stack_array.h"
 #include "vk_drm_syncobj.h"
 #include "vk_log.h"
 #include "vk_sync.h"
