+static bool
+panvk_drop_clip_cull_vars(nir_shader *nir)
+{
+   return panvk_drop_clip_cull_vars_mode(nir, false);
+}
+
+/* Number of clip distances a geometry stage still writes (kept by
+ * panvk_drop_clip_cull_vars_mode() as vec4s at CLIP_DIST0/1). */
+static unsigned
+panvk_clip_distance_count(nir_shader *nir)
+{
+   unsigned count = 0;
+
+   nir_foreach_shader_out_variable(var, nir) {
+      if (var->data.location == VARYING_SLOT_CLIP_DIST0 ||
+          var->data.location == VARYING_SLOT_CLIP_DIST1) {
+         unsigned base = var->data.location == VARYING_SLOT_CLIP_DIST1 ? 4 : 0;
+         count = MAX2(count, base + glsl_count_attribute_slots(var->type, false) * 4);
+      }
+   }
+   return MIN2(MIN2(count, nir->info.clip_distance_array_size ?
+                              nir->info.clip_distance_array_size : count), 8);
+}
+
+/* Clip distances as a fragment-shader discard, the way GL drivers for
+ * hardware without clip planes do it: the vertex shader passes the
+ * distances on as varyings and the fragment shader kills the fragments
+ * where any is negative. Only where both are compiled together (a linked
+ * pipeline, or DXVK's optimized pipeline after its fast-linked one), as
+ * the fragment shader must know the vertex shader writes them; elsewhere
+ * the distances are dropped and the primitive drawn unclipped, as before. */
+static void
+panvk_link_clip_distances(struct vk_shader_compile_info *infos,
+                          uint32_t shader_count)
+{
+   for (uint32_t i = 0; i < shader_count; i++) {
+      nir_shader *nir = infos[i].nir;
+      if (nir->info.stage == MESA_SHADER_FRAGMENT ||
+          nir->info.stage == MESA_SHADER_COMPUTE)
+         continue;
+
+      unsigned count = panvk_clip_distance_count(nir);
+      bool linked = nir->info.stage == MESA_SHADER_VERTEX &&
+                    i + 1 < shader_count &&
+                    infos[i + 1].nir->info.stage == MESA_SHADER_FRAGMENT &&
+                    infos[i].next_stage_mask == VK_SHADER_STAGE_FRAGMENT_BIT;
+
+      if (!count || !linked) {
+         if (count)
+            NIR_PASS(_, nir, panvk_drop_clip_cull_vars);
+         continue;
+      }
+
+      nir_shader *fs = infos[i + 1].nir;
+      nir_variable *in = nir_variable_create(
+         fs, nir_var_shader_in,
+         count > 4 ? glsl_array_type(glsl_vec4_type(), 2, 0) : glsl_vec4_type(),
+         "clip_distances");
+      in->data.location = VARYING_SLOT_CLIP_DIST0;
+      in->data.interpolation = INTERP_MODE_NONE;
+
+      nir_function_impl *impl = nir_shader_get_entrypoint(fs);
+      nir_builder b = nir_builder_at(nir_before_impl(impl));
+      nir_def *cond = NULL;
+      for (unsigned d = 0; d < count; d++) {
+         nir_deref_instr *deref = nir_build_deref_var(&b, in);
+         if (count > 4)
+            deref = nir_build_deref_array_imm(&b, deref, d / 4);
+         nir_def *v = nir_channel(&b, nir_load_deref(&b, deref), d % 4);
+         nir_def *neg = nir_flt_imm(&b, v, 0.0);
+         cond = cond ? nir_ior(&b, cond, neg) : neg;
+      }
+      nir_discard_if(&b, cond);
+      fs->info.fs.uses_discard = true;
+      nir_progress(true, impl, nir_metadata_none);
+   }
+}
