#!/usr/bin/python3
"""Log the busiest threads of a running game, so a slow game shows whether a CPU thread is the limit.

droiddeck-thread-load PID [INTERVAL]: every INTERVAL seconds (default 15), print the six threads of
Windows processes (*.exe) that used the most CPU, as a percentage of one core, until PID has exited
and no Windows process has run for a minute."""
import fcntl
import os
import sys
import time

TICKS = os.sysconf("SC_CLK_TCK")


def exe_pids():
    """Processes running a Windows program: Wine puts the program's path in argv[0]."""
    pids = []
    for name in os.listdir("/proc"):
        if not name.isdigit():
            continue
        try:
            with open("/proc/%s/cmdline" % name, "rb") as f:
                args = f.read().split(b"\0")
        except OSError:
            continue
        for arg in args[:2]:
            if arg.lower().endswith(b".exe"):
                pids.append((name, os.path.basename(arg.replace(b"\\", b"/")).decode(errors="replace")))
                break
    return pids


def thread_times():
    times = {}
    for pid, exe in exe_pids():
        try:
            tids = os.listdir("/proc/%s/task" % pid)
        except OSError:
            continue
        for tid in tids:
            try:
                with open("/proc/%s/task/%s/stat" % (pid, tid)) as f:
                    stat = f.read()
            except OSError:
                continue
            name = stat[stat.index("(") + 1:stat.rindex(")")]
            fields = stat[stat.rindex(")") + 2:].split()
            times[(pid, tid)] = (exe, name, int(fields[11]) + int(fields[12]))
    return times


def main():
    if len(sys.argv) < 2:
        return 2
    # Every game launch starts one; the first keeps logging for all of them.
    lock = open("/tmp/droiddeck-thread-load.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return 0
    watched = sys.argv[1]
    interval = float(sys.argv[2]) if len(sys.argv) > 2 else 15.0
    print("droiddeck-thread-load: watching %s every %.0f s" % (watched, interval), file=sys.stderr, flush=True)
    before, then = thread_times(), time.monotonic()
    last_seen = then
    while os.path.exists("/proc/" + watched) or then - last_seen < 60:
        time.sleep(interval)
        now, at = thread_times(), time.monotonic()
        elapsed = (at - then) * TICKS
        busy = []
        for key, (exe, name, ticks) in now.items():
            if key in before:
                busy.append((100.0 * (ticks - before[key][2]) / elapsed, exe, name))
        busy.sort(reverse=True)
        if now:
            last_seen = at
        else:
            print("droiddeck-thread-load: no Windows process running", file=sys.stderr, flush=True)
        if busy:
            total = sum(b[0] for b in busy)
            top = ", ".join("%s %.0f%%" % (name, load) for load, _, name in busy[:6])
            print("droiddeck-thread-load: %s total %.0f%% | %s" % (busy[0][1], total, top), file=sys.stderr, flush=True)
        before, then = now, at
    return 0


if __name__ == "__main__":
    sys.exit(main())
